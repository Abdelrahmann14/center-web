# Copy to .env.local (gitignored) for local overrides. Nothing secret belongs
# in ANY of these files: Vite inlines every VITE_* value into the JavaScript
# bundle it ships to the browser, so a "secret" here is public the moment the
# site is. API keys stay on the backend.

# Backend ORIGIN, when the API is not on this site's own origin - a Vercel
# deployment against a backend hosted elsewhere. Origin only: no trailing
# slash, no /api suffix (the app appends it).
#
#   VITE_API_URL=https://center-api.fly.dev
#
# Leave it UNSET for same-origin setups, which is what local development uses:
# `npm run dev` proxies /api to http://127.0.0.1:8001 (see vite.config.ts), and
# the desktop shell proxies it too.
#
# Whatever origin this site ends up on must also be listed in the backend's
# CORS_ALLOWED_ORIGINS, or the browser refuses every call.
VITE_API_URL=
